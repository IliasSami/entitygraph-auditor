# EntityGraph Auditor Configuration

# Database (Default: local SQLite database in ./var persistent directory)
DATABASE_URL=sqlite:///./var/ega.db


# API Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Default Model Provider (options: dummy, ollama, openai, anthropic, gemini)
DEFAULT_MODEL_PROVIDER=dummy

# Ollama Configuration (Local Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Cloud Providers (Optional BYOK)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# MCP Server Settings
MCP_SERVER_NAME=entitygraph-auditor-mcp
MCP_SERVER_VERSION=0.1.0

# ---------------------------------------------------------------------------
# EntityGraph Auditor (EGA_ prefixed — canonical; unprefixed names above are
# also honoured for compatibility, see apps/api/app/config.py)
# ---------------------------------------------------------------------------
# EGA_DATABASE_URL=sqlite:///./var/ega.db
# EGA_DATA_DIR=./var
# APP_ENCRYPTION_KEY=            # required to store provider/API/MCP secrets
# EGA_AUTH_TOKEN=                # optional single-user bearer gate (set for remote access)
# EGA_ALLOW_PRIVATE_URLS=false   # SSRF guard: keep false outside development
# EGA_DEFAULT_PROVIDER=null      # null = deterministic-only mode (no model needed)
# EGA_DETERMINISTIC_ONLY=false
# EGA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# EGA_CACHE_ENABLED=true
# EGA_DOCS_ENABLED=true

