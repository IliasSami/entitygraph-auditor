# EntityGraph Auditor — Docker Build Ignore

# Version control
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Web
**/node_modules/
**/.next/
**/.turbo/
**/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files must never be baked into images: Next.js gives `.env.local`
# priority over the shell environment, so a copied `.env.local` would silently
# override the `NEXT_PUBLIC_API_BASE` build arg.
**/.env.local
**/.env.*.local

# Databases and data
*.db
*.db-journal
*.sqlite
*.sqlite3
var/*.db
var/cache/

# Exception: ship the read-only PrismGEO sample dataset used by the AI
# Visibility screen (/compare → /api/visibility).
!prism-geo/data/prismgeo.db

# Scratch & artifacts
scratch/
.system_generated/
