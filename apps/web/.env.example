# Base URL of the EntityGraph Auditor FastAPI backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Set to 1 to serve deterministic in-memory sample data instead of calling the
# backend. The whole UI is demoable in this mode; every mock-driven view shows a
# "Sample data" banner. Values are inlined at build time, so rebuild after
# changing them.
NEXT_PUBLIC_MOCK=0
